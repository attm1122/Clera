rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Profile subcollection
      match /profile/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Skin scans
      match /skinScans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Skin map snapshots
      match /skinMapSnapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Routine logs
      match /routineLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Current products
      match /currentProducts/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Routine changes
      match /routineChanges/{changeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Experiments
      match /experiments/{experimentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily advice history
      match /dailyAdvice/{adviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Device state
      match /deviceState/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
